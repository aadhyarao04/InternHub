# =================================================================
# InternHub AI - Environment Configuration Template
# Copy this file to .env and fill in with your real environment keys.
# DO NOT commit real secrets or credentials to Git.
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/internhub_ai

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Optional: AI Provider Keys (System includes built-in fallback heuristics if left empty)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Email Service (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=InternHub AI <noreply@internhub.ai>

# Frontend Client Base URL (Leave /api/v1 for local Vite proxy)
VITE_API_BASE_URL=/api/v1
